<?xml version="1.0" encoding="UTF-8"?>
<!-- ==========================================================================
     iOS 应用清单（路线图 P3-T15）
     说明：
       * CJING_ 前缀的变量由 CMake 的 configure_file 在配置阶段替换
         （来自 CMakeLists 的 set_target_properties）；
       * UILaunchScreen 是现代 iOS 的启动屏声明——**缺失会导致审核被拒**
         （Apple 要求应用必须提供启动屏）；<dict/> 即"使用纯色默认启动屏"。
       * 只允许竖屏：棋盘是正方形，横屏无收益，且与 HUD 布局一致。
     ========================================================================== -->
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
    <key>CFBundleDevelopmentRegion</key>
    <string>zh_CN</string>

    <key>CFBundleExecutable</key>
    <string>@CJING_EXECUTABLE_NAME@</string>

    <key>CFBundleIdentifier</key>
    <string>@CJING_BUNDLE_ID@</string>

    <key>CFBundleInfoDictionaryVersion</key>
    <string>6.0</string>

    <key>CFBundleName</key>
    <string>@CJING_DISPLAY_NAME@</string>

    <!-- 桌面图标下显示的名字 -->
    <key>CFBundleDisplayName</key>
    <string>井字棋</string>

    <key>CFBundlePackageType</key>
    <string>APPL</string>

    <key>CFBundleShortVersionString</key>
    <string>@CJING_VERSION@</string>

    <key>CFBundleVersion</key>
    <string>@CJING_BUILD@</string>

    <key>LSRequiresIPhoneOS</key>
    <true/>

    <key>MinimumOSVersion</key>
    <string>@CJING_DEPLOYMENT_TARGET@</string>

    <!-- iPad 上要求全屏：iPadOS 26 默认以可缩放窗口运行，
         游戏类应用应铺满屏幕（用户仍可用系统手势退出）。
         注意：苹果在较新系统上已把它标记为废弃，若被忽略则退回窗口模式。 -->
    <key>UIRequiresFullScreen</key>
    <true/>

    <!-- 启动屏（缺失会被拒审） -->
    <key>UILaunchScreen</key>
    <dict/>

    <!-- 设备族：1=iPhone, 2=iPad。
         不声明 2 的话，iPad 上会以「iPhone 兼容模式」运行（窗口只有 320x480），
         既浪费屏幕，也让自适应布局无从发挥。 -->
    <key>UIDeviceFamily</key>
    <array>
        <integer>1</integer>
        <integer>2</integer>
    </array>

    <!-- iPhone：只允许竖屏（棋盘正方形，横屏无收益） -->
    <key>UISupportedInterfaceOrientations</key>
    <array>
        <string>UIInterfaceOrientationPortrait</string>
    </array>

    <!-- iPad：允许横屏——这正是宽屏排布（棋盘靠左、HUD 靠右）的用武之地 -->
    <key>UISupportedInterfaceOrientations~ipad</key>
    <array>
        <string>UIInterfaceOrientationPortrait</string>
        <string>UIInterfaceOrientationPortraitUpsideDown</string>
        <string>UIInterfaceOrientationLandscapeLeft</string>
        <string>UIInterfaceOrientationLandscapeRight</string>
    </array>

    <!-- 允许外接鼠标/触控板（iPadOS 指针支持） -->
    <key>UIApplicationSupportsIndirectInputEvents</key>
    <true/>

    <!-- 游戏不需要状态栏，交给全屏绘制 -->
    <key>UIStatusBarHidden</key>
    <true/>
</dict>
</plist>
