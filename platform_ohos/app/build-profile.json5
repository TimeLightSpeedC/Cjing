{
  "app": {
    "products": [
      {
        "name": "default",
        // 签名：材料不入库（说明见文件末尾 signingConfigs）。
        // 在 DevEco 生成后，把这一行加回来："signingConfig": "default",
        // 未配置时产出未签名 HAP（模拟器可装，真机拒装）。
        "targetSdkVersion": "5.0.4(16)",
        "compatibleSdkVersion": "5.0.4(16)",
        "runtimeOS": "HarmonyOS",
        "buildOption": {
          "nativeCompiler": "BiSheng",
          "strictMode": {
            "caseSensitiveCheck": true,
            "useNormalizedOHMUrl": true
          }
        }
      }
    ],
    "buildModeSet": [
      {
        "name": "debug"
      },
      {
        "name": "release"
      }
    ],
    "signingConfigs": [
      // =====================================================================
      //  这里是【本机】签名材料，不提交到仓库（含加密后的 keystore 密码）。
      //
      //  首次使用请在 DevEco Studio 里生成：
      //    File → Project Structure → Signing Configs
      //    → 勾选 Automatically generate signature（需登录华为账号）
      //
      //  DevEco 会在此处写入类似下面的内容，并生成材料到 ~/.ohos/config/：
      //
      //  {
      //    "name": "default",
      //    "type": "HarmonyOS",
      //    "material": {
      //      "certpath": "~/.ohos/config/default_app_xxx.cer",
      //      "keyAlias": "debugKey",
      //      "keyPassword": "<加密串>",
      //      "profile": "~/.ohos/config/default_app_xxx.p7b",
      //      "signAlg": "SHA256withECDSA",
      //      "storeFile": "~/.ohos/config/default_app_xxx.p12",
      //      "storePassword": "<加密串>"
      //    }
      //  }
      //
      //  ⚠️ 生成后请务必确认 products 里出现这一行（否则报「未检测到签名配置」）：
      //      "signingConfig": "default",
      // =====================================================================
      {
        "name": "default",
        "type": "HarmonyOS",
        "material": {
          "certpath": "/Users/c/.ohos/config/default_app_QHNiDBEXCmH0EMJYCKOXTZdtbF8FoDQMGqAjO5Oj2xE=.cer",
          "keyAlias": "debugKey",
          "keyPassword": "0000001B9BFA193DBB15EC9971EC12117AC2D35CEDCBA2B39A70A4223CE0C66D448EEB0A6B75DBC9BB419F",
          "profile": "/Users/c/.ohos/config/default_app_QHNiDBEXCmH0EMJYCKOXTZdtbF8FoDQMGqAjO5Oj2xE=.p7b",
          "signAlg": "SHA256withECDSA",
          "storeFile": "/Users/c/.ohos/config/default_app_QHNiDBEXCmH0EMJYCKOXTZdtbF8FoDQMGqAjO5Oj2xE=.p12",
          "storePassword": "0000001B543E46F57C00D70AF4715DDAF0BE8CF99217E673EB7BA544BAA999239DB578E81B907696FB0454"
        }
      }
    ]
  },
  "modules": [
    {
      "name": "entry",
      "srcPath": "./entry",
      "targets": [
        {
          "name": "default",
          "applyToProducts": [
            "default"
          ]
        }
      ]
    }
  ]
}